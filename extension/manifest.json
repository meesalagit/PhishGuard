{
  "manifest_version": 3,
  "name": "PhishGuard — Email Phishing Detector",
  "version": "1.0",
  "description": "Real-time phishing detection for Gmail using hybrid ML",
  "permissions": [
    "activeTab"
  ],
  "host_permissions": [
    "https://mail.google.com/*",
    "http://127.0.0.1:5000/*"
  ],
  "content_scripts": [
    {
      "matches": ["https://mail.google.com/*"],
      "js": ["content.js"],
      "css": ["ui.css"],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16":  "icon.png",
    "48":  "icon.png",
    "128": "icon.png"
  },
  "action": {
    "default_title": "PhishGuard"
  }
}